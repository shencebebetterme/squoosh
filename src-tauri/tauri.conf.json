{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "量子图片处理",
  "version": "2.0.0",
  "identifier": "com.ce.squoosh",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "npm run dev:tauri:web",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "量子图片处理",
        "width": 1440,
        "height": 960,
        "minWidth": 1100,
        "minHeight": 720,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      },
      "wix": {
        "language": "zh-CN"
      }
    }
  }
}
